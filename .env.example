# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ─── Google Maps ──────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → Maps JavaScript API
VITE_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ─── Claude AI (for AI Assistant) ─────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
# NOTE: In production, calls go through a backend Edge Function — never expose this in client
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ─── Stripe (for subscriptions) ───────────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_KEY
